# Example only. Copy to .env on the server and fill in values there.
# Never commit a real .env. Never paste real values into chat.

# Set by the owner. Generate a fresh value on the server; do not reuse anything from chat.
ENCRYPTION_KEY=replace-with-a-fresh-random-value

# Bind to localhost; the reverse proxy is the only public entry point.
HOST_BIND=127.0.0.1
PORT=3001

# Watchtower self-update stays OFF unless the owner decides otherwise.
# WATCHTOWER_TOKEN=

# Provider keys are added in the gateway's own dashboard or secrets store, not here.

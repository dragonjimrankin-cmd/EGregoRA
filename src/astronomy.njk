          <text x="26" y="160" text-anchor="middle" transform="rotate(-90 26 160)">LUMINOSITY</text>
        </g>
        <g font-family="EB Garamond, serif" font-size="10" fill="#9f947a" text-anchor="middle">
          <text x="100" y="304">O 30,000K</text>
          <text x="170" y="304">B</text>
          <text x="240" y="304">A</text>
          <text x="310" y="304">F</text>
          <text x="370" y="304">G 5,800K</text>
          <text x="440" y="304">K</text>
          <text x="505" y="304">M 3,000K</text>
        </g>
        <path d="M95 60 C180 110 280 170 370 210 C430 236 480 255 515 268"
              fill="none" stroke="#f3ddaa" stroke-width="10" stroke-linecap="round" opacity="0.22"/>
        <path d="M95 60 C180 110 280 170 370 210 C430 236 480 255 515 268"
              fill="none" stroke="#f3ddaa" stroke-width="1.6"/>
        <g fill="#c98b6a" opacity="0.85">
          <ellipse cx="455" cy="105" rx="58" ry="30"/>
        </g>
        <g fill="#8fb6d8" opacity="0.8">
          <ellipse cx="175" cy="248" rx="42" ry="18"/>
        </g>
        <circle cx="370" cy="210" r="5" fill="#d7b05a"/>
        <g font-family="EB Garamond, serif" font-size="11" fill="#f3ddaa">
          <text x="300" y="150">The Main Sequence</text>
          <text x="455" y="109" text-anchor="middle" fill="#0e0c0a">RED GIANTS</text>
          <text x="175" y="252" text-anchor="middle" fill="#0e0c0a">WHITE DWARFS</text>
          <text x="382" y="214">the Sun</text>

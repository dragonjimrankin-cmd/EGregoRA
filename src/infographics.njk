    <figure class="frame reveal">
      <svg class="svg-info" viewBox="0 0 400 300" role="img" aria-label="The entropic brain: ordinary versus expanded states of consciousness">
        <g font-family="Cinzel, serif" font-size="11" fill="#f3dd9c"><text x="20" y="28">THE ENTROPIC BRAIN</text></g>

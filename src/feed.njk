---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0"><channel>
<title>EGregoRA — The Podcast</title>
<link>https://egregora.org/podcast/</link>
<description>{{ site.description }}</description>
<language>en-gb</language>
{%- for ep in episodes | reverse %}
<item>
  <title>{{ ep.number }} — {{ ep.title }}</title>
  <link>https://egregora.org/podcast/</link>
  <guid isPermaLink="false">egregora-ep-{{ ep.number }}</guid>
  <description>{{ ep.summary }}</description>
  <pubDate>{{ ep.date }}</pubDate>
  {%- if ep.audio %}<enclosure url="{{ ep.audio }}" type="audio/mpeg"/>{% endif %}
</item>
{%- endfor %}
</channel></rss>

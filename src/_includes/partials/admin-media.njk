{#- The Admin Only publishing door. Used on /podcast/ (kind = audio) and
    /videos/ (kind = video). Everything inside is addressed by data-am,
    so the two copies cannot collide; the handful of real ids are prefixed
    with the kind. -#}
<section class="wrap narrow admin-media" data-admin-media="{{ amKind }}"
  data-after="{{ amAfter | default(0) }}">
  <div class="btn-row">
    <button type="button" class="btn btn--ghost" data-am="open" aria-expanded="false">Admin Only</button>
    <span class="muted xsmall">Upload {{ amNoun }}, clean {{ amIt }} up, edit {{ amIt }}, publish {{ amIt }}
    &mdash; no laptop, no commit.</span>
  </div>

  <div class="frame admin-panel" data-am="panel" hidden>
    <p class="kicker">The Order&rsquo;s Passcode</p>
    <div class="admin-signin">
      <label for="{{ amKind }}-pass">Passcode</label>
      <input type="password" id="{{ amKind }}-pass" data-am="pass" autocomplete="current-password"
             placeholder="&bull;&bull;&bull;&bull;&bull;">
      <button type="button" class="btn btn--small" data-am="signin">Open the door</button>
    </div>
    <p class="auth-msg" data-am="msg"></p>

    <div data-am="work" hidden>
      <div class="divider">&#10022;</div>

      <p class="kicker">1. Recording</p>
      <div class="btn-row">
        <button type="button" class="btn btn--small btn--ghost" data-am="rec-open">
          Record it here instead</button>
        <span class="muted xsmall">Straight into the browser, with ten seconds to settle first.</span>
      </div>

      <div class="am-rec" data-am="rec" hidden>
        {% if amKind == "video" %}
        <div class="am-fields">
          <div>
            <label for="{{ amKind }}-rec-source">What to record</label>
            <select id="{{ amKind }}-rec-source" data-am="rec-source">
              <option value="cam">Camera and microphone</option>
              <option value="screen">This screen, with microphone</option>
            </select>
          </div>
          <div>
            <label for="{{ amKind }}-rec-quality">Quality</label>
            <select id="{{ amKind }}-rec-quality" data-am="rec-quality">
              <option value="low">Low</option>
              <option value="mid" selected>Middling</option>
              <option value="high">High</option>
            </select>
          </div>
        </div>
        {% endif %}
        <div class="btn-row">
          <button type="button" class="btn btn--small" data-am="rec-start">
            Start recording &mdash; ten second countdown</button>
          <button type="button" class="btn btn--small btn--ghost" data-am="rec-stop" disabled>Stop</button>
        </div>
        <div class="countdown" data-am="rec-count" hidden></div>
        <p class="am-rec-state muted small" data-am="rec-state"></p>
        {% if amKind == "video" %}
        <video class="live-mirror" data-am="rec-mirror" muted playsinline
               aria-label="What the camera is seeing" role="img"></video>
        {% else %}
        <canvas class="am-meter" data-am="rec-meter" width="600" height="56"
                aria-label="The level of what is being recorded" role="img"></canvas>
        {% endif %}
      </div>

      <label for="{{ amKind }}-file">Or choose {{ amNoun }} already recorded
        {% if amKind != "video" %}<span class="muted xsmall">— MP3, WAV, FLAC, AAC, M4A, MP4 or WMA</span>{% endif %}</label>
      <input type="file" id="{{ amKind }}-file" data-am="file"
             accept="{% if amKind == 'video' %}video/*{% else %}audio/*,video/mp4,.mp3,.wav,.flac,.aac,.m4a,.wma,.mp4{% endif %}">

      <div class="am-pair">
        <div data-am="before"></div>
        <div data-am="after"></div>
      </div>

      <p class="kicker">2. Work</p>
      {% if amKind == "audio" %}
      <p class="muted small">All of this happens in this browser, on this machine, before anything is
      sent. The file is decoded, run through the chain below and rendered offline &mdash; usually faster
      than real time &mdash; then encoded to MP3. Nothing is uploaded until you have listened to it.</p>
      {% else %}
      <p class="muted small">A browser has no transcoder, so a graded film is <em>re-recorded</em>
      through a canvas at playback speed: twenty minutes of film takes about twenty minutes, and the
      result is WebM. If that is not what you want, leave every box unticked and press publish &mdash;
      the original is uploaded untouched.</p>
      {% endif %}

      <div class="am-opts" data-am="opts">
        <label><input type="checkbox" data-want="rumble" checked> Filter the rumble below 72&nbsp;Hz</label>
        <label><input type="checkbox" data-want="gate" checked> Shelve the hiss</label>
        <label><input type="checkbox" data-want="tone" checked> Shape the tone &mdash; mud down, presence and air up</label>
        <label><input type="checkbox" data-want="deess"> De-ess the sibilance</label>
        <label><input type="checkbox" data-want="level" checked> Level it &mdash; gentle compression</label>
        <label><input type="checkbox" data-want="loud" checked> Match the loudness, then limit the peaks</label>
        {% if amKind == "audio" %}
        <label><input type="checkbox" data-want="denoise" checked> Gate the silences &mdash; sniffs and coughs out, every word left whole</label>
        <label><input type="checkbox" data-want="roomtone" checked> Lay the room&rsquo;s tone under the silences &mdash; the background stays continuous</label>
        <label><input type="checkbox" data-want="destutter"> Remove stuttering &mdash; a syllable repeated in place is muted; the word itself is never touched</label>
        <label><input type="checkbox" data-want="trim" checked> Trim the silence from both ends</label>
        <label><input type="checkbox" data-want="gaps" checked> Close the long speechless stretches</label>
        <label><input type="checkbox" data-want="fade" checked> Fade in and out</label>
        {% else %}
        <label><input type="checkbox" data-want="grade" checked> Grade the picture &mdash; a touch of brightness, contrast and colour</label>
        <label><input type="checkbox" data-want="shrink" checked> Reduce to 720p-class width</label>
        {% endif %}
      </div>

      {% if amKind == "audio" %}
      <div class="am-fields">
        <div>
          <label for="{{ amKind }}-gaphold">Count it a gap after (seconds)</label>
          <input type="number" id="{{ amKind }}-gaphold" data-am="gaphold" min="0.6" max="20" step="0.1" value="1.5">
        </div>
        <div>
          <label for="{{ amKind }}-gapleave">Leave this much of it (seconds)</label>
          <input type="number" id="{{ amKind }}-gapleave" data-am="gapleave" min="0" max="3" step="0.05" value="0.45">
        </div>
      </div>
      <p class="muted xsmall">A pause is not a fault &mdash; silence removed completely sounds wrong,
      because conversation has rhythm. Long stretches are shortened to the breath you leave here,
      not deleted. The gate opens just <em>before</em> each word and holds across it, so speech is
      never clipped; only noise that stands alone between phrases &mdash; a cough, a sniff, a chair
      knock &mdash; gets shut out.</p>
      <p class="muted xsmall">Stuttering removal is off by default and deliberately shy. It looks
      for one pattern only &mdash; the same short syllable landing two or more times in a row, then
      the word itself &mdash; and mutes only the repeats before it: the last repeat and the word
      always stand, so a word a person chose to say twice survives. If the pattern fires too often
      to be trusted, nothing is touched at all. Every place it touched is listed under the
      reading, and the original can always be published instead.</p>
      <p class="muted xsmall">The room&rsquo;s tone is the opposite of the gate&rsquo;s scissors: where
      the gate shut and left digital zero, noise measured from the recording&rsquo;s own floor is
      laid back down &mdash; warmed, slowly breathing, never louder than the room itself &mdash; so
      the background runs unbroken from the first word to the last. Where the room already
      breathes, nothing is added; a recording with no floor at all is left in its studio silence.</p>
      {% endif %}

      <label for="{{ amKind }}-loud">Target loudness (dB RMS)</label>
      <input type="range" id="{{ amKind }}-loud" data-am="loud" min="-28" max="-10" step="1" value="-18">

      <div class="btn-row">
        <button type="button" class="btn btn--small" data-am="run">
          {% if amKind == "audio" %}Enhance it{% else %}Grade it{% endif %}
        </button>
      </div>
      <p class="am-bar" data-am="bar" hidden></p>
      <div data-am="preview"></div>
      <p class="kicker">3. {% if amKind == "audio" %}Words{% else %}Details{% endif %}</p>
      {% if amKind == "audio" %}
      <div class="btn-row">
        <button type="button" class="btn btn--small" data-am="hear">Transcribe it and write the listing</button>
        <button type="button" class="btn btn--small btn--ghost" data-am="summarise"
                disabled>Write the summary from the transcript</button>
        <span class="muted xsmall">Title, summary, tags and the parts of the site it touches &mdash;
        written from the recording itself.</span>
      </div>
      <div data-am="listing" hidden></div>
      {% endif %}

      <div data-am="meta" hidden>
<div class="am-fields">
          <div>
            <label for="{{ amKind }}-title">Title</label>
            <input type="text" id="{{ amKind }}-title" data-am="title" maxlength="200">
          </div>
          {% if amKind == "audio" %}
          <div>
            <label for="{{ amKind }}-number">Episode number</label>
            <input type="text" id="{{ amKind }}-number" data-am="number" maxlength="12"
                   placeholder="taken automatically">
          </div>
          {% endif %}
          <div class="am-tagfield">
            <label for="{{ amKind }}-tags">Tags, comma separated</label>
            <input type="text" id="{{ amKind }}-tags" data-am="tags" maxlength="300" placeholder="astronomy, druidry">
          </div>
        </div>
        <details class="scroll am-tagbook">
          <summary>The house vocabulary &mdash; tap a subject to add it</summary>
          <p class="muted xsmall">Everything this house is about, grouped. The archivist already
          prefers these words when it writes the tags itself; these are here for the ones it missed,
          and for an upload you are listing by hand. Tap again to take one off.</p>
          {%- for group, words in subjects %}
          <p class="kicker">{{ group }}</p>
          <div class="am-chips">
            {%- for w in words %}
            <button type="button" class="am-chip" data-tag="{{ w }}">{{ w }}</button>
            {%- endfor %}
          </div>
          {%- endfor %}
        </details>

        <label for="{{ amKind }}-summary">Summary</label>
        <textarea id="{{ amKind }}-summary" data-am="summary" rows="3" maxlength="2000"></textarea>
        <div class="btn-row" data-am="pubrow">
          <button type="button" class="btn" data-am="pubnow">Publish it on the site</button>
        </div>
      </div>

      {% set faWhere = amKind %}
      {% include "partials/freeai-doors.njk" %}

      <div class="divider">&#10022;</div>
      <p class="kicker">What has come through this door</p>
      <div data-am="shelf"></div>
    </div>
  </div>
</section>

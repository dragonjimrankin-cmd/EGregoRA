<footer class="site-foot">
  <div class="foot-glyph">{% glyph "seed" %}</div>
  <p class="foot-motto">{{ site.motto }}</p>
  <nav class="foot-nav" aria-label="Footer">
    {% for item in site.nav %}<a href="{{ item.url }}">{{ item.label }}</a>{% endfor %}
  </nav>
  <p class="foot-fine">
    EGregoRA was co-founded by <strong>{{ site.cofounder }}</strong> and <strong>{{ site.cofounder2 }}</strong>. All enquiry here is offered in the spirit of
    free thought and free doubt — test everything, keep what is true.
  </p>
  <p class="foot-fine small">© {{ "" | year }} EGregoRA · {{ site.tagline }} · <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
  <p class="foot-fine small"><button class="linkish" type="button" id="cookie-reopen">Storage &amp; cookie choice</button></p>
</footer>

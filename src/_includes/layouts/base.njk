<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} · {{ site.name }}</title>
<meta name="description" content="{{ description or site.description }}">
<meta property="og:title" content="{{ title }} · {{ site.name }}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:type" content="website">
<link rel="icon" href="/assets/img/sigil.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700;900&family=Cinzel:wght@400;600&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Cormorant+Unicase:wght@600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/main.css">
</head>
<body data-page="{{ page.fileSlug or 'home' }}">
<canvas id="starfield" aria-hidden="true"></canvas>
<div class="veil" aria-hidden="true"></div>

<a class="skip" href="#main">Skip to the work</a>

{% include "partials/header.njk" %}

<main id="main">
  {{ content | safe }}
</main>

{% include "partials/footer.njk" %}
<script src="/assets/js/site.js" defer></script>
</body>
</html>

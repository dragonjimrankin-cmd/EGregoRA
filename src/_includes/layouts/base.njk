<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark">
<meta name="theme-color" content="{{ site.themeColor }}">

{#- One computed set of values, used by every tag below. -#}
{%- set pageTitle = (metaTitle or (title + " · " + site.name)) -%}
{%- set pageDesc = (description or site.description) | striptags | trim -%}
{%- set pageUrl = site.url + page.url -%}
{%- set pageImage = site.url + (image or site.ogImage) -%}
{%- set pageKeywords = keywords or site.keywords -%}

<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<meta name="keywords" content="{{ pageKeywords }}">
<meta name="author" content="{{ site.cofounder }} &amp; {{ site.cofounder2 }}">
<meta name="publisher" content="{{ site.name }}">
<meta name="robots" content="{{ robots or 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1' }}">
<meta name="googlebot" content="{{ robots or 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1' }}">
<meta name="referrer" content="strict-origin-when-cross-origin">
<meta name="format-detection" content="telephone=no">
<meta name="rating" content="general">
<link rel="canonical" href="{{ pageUrl }}">

{#- Open Graph: Facebook, LinkedIn, WhatsApp, Slack, Discord, iMessage. -#}
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:locale" content="{{ site.locale }}">
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ pageUrl }}">
<meta property="og:image" content="{{ pageImage }}">
<meta property="og:image:secure_url" content="{{ pageImage }}">
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ imageAlt or site.ogImageAlt }}">
{%- if ogType == 'article' %}
<meta property="article:author" content="{{ site.cofounder }}">
<meta property="article:publisher" content="{{ site.url }}">
<meta property="article:section" content="{{ section or 'Esoteric enquiry' }}">
{%- if published %}<meta property="article:published_time" content="{{ published }}">{% endif %}
<meta property="article:modified_time" content="{{ page.date | isoDate }}">
{%- endif %}

{#- X / Twitter. -#}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDesc }}">
<meta name="twitter:image" content="{{ pageImage }}">
<meta name="twitter:image:alt" content="{{ imageAlt or site.ogImageAlt }}">

{#- Icons, manifest, feeds, and the other end of a share. -#}
<link rel="icon" href="/assets/img/sigil.svg" type="image/svg+xml">
<link rel="icon" href="/assets/img/favicon-32.png" sizes="32x32" type="image/png">
<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png" sizes="180x180">
<link rel="manifest" href="/site.webmanifest">
<meta name="apple-mobile-web-app-title" content="{{ site.name }}">
<meta name="application-name" content="{{ site.name }}">
<link rel="alternate" type="application/rss+xml" title="{{ site.name }} — the order's feed" href="{{ site.url }}/feed.xml">
<link rel="sitemap" type="application/xml" href="/sitemap.xml">
<link rel="me" href="mailto:{{ site.email }}">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="dns-prefetch" href="https://fonts.gstatic.com">
<link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700;900&family=Cinzel:wght@400;600&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Cormorant+Unicase:wght@600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/main.css?v={{ build.id }}">

{#- Structured data. Organization and WebSite are site-wide; WebPage and the
    breadcrumb are per page; a page may add FAQPage entries of its own. -#}
<script type="application/ld+json">
{{ {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "EducationalOrganization"],
      "@id": site.url + "/#organization",
      "name": site.name,
      "alternateName": "The Order of EGregoRA",
      "url": site.url,
      "email": site.email,
      "slogan": site.tagline,
      "description": site.description,
      "foundingDate": site.founded,
      "logo": { "@type": "ImageObject", "url": site.url + "/assets/img/icon-512.png", "width": 512, "height": 512 },
      "image": site.url + site.ogImage,
      "knowsAbout": site.keywords | split(", "),
      "founder": [
        { "@type": "Person", "name": site.cofounder, "jobTitle": "Co-founder" },
        { "@type": "Person", "name": site.cofounder2, "jobTitle": "Co-founder" }
      ]
    },
    {
      "@type": "WebSite",
      "@id": site.url + "/#website",
      "url": site.url,
      "name": site.name,
      "description": site.description,
      "inLanguage": site.lang,
      "publisher": { "@id": site.url + "/#organization" },
      "potentialAction": {
        "@type": "SearchAction",
        "target": { "@type": "EntryPoint", "urlTemplate": site.url + "/ask-ed/?q={search_term_string}" },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": (schemaType or "WebPage"),
      "@id": pageUrl + "#page",
      "url": pageUrl,
      "name": pageTitle,
      "headline": title,
      "description": pageDesc,
      "inLanguage": site.lang,
      "isPartOf": { "@id": site.url + "/#website" },
      "about": { "@id": site.url + "/#organization" },
      "primaryImageOfPage": { "@type": "ImageObject", "url": pageImage, "width": 1200, "height": 630 },
      "author": [
        { "@type": "Person", "name": site.cofounder },
        { "@type": "Person", "name": site.cofounder2 }
      ],
      "publisher": { "@id": site.url + "/#organization" },
      "dateModified": buildDate,
      "keywords": pageKeywords
    },
    {
      "@type": "BreadcrumbList",
      "@id": pageUrl + "#breadcrumb",
      "itemListElement": ([{ "@type": "ListItem", "position": 1, "name": "Introduction", "item": site.url + "/" }] if page.url == "/" else [
        { "@type": "ListItem", "position": 1, "name": "Introduction", "item": site.url + "/" },
        { "@type": "ListItem", "position": 2, "name": title, "item": pageUrl }
      ])
    }
  ]
} | dump | safe }}
</script>
{%- if faq %}
<script type="application/ld+json">
{{ { "@context": "https://schema.org", "@type": "FAQPage", "@id": pageUrl + "#faq", "mainEntity": faq } | dump | safe }}
</script>
{%- endif %}
  <script>
    /* The scroll-reveal fade is armed here, before the first paint, so the
       page never flashes its panels in and then hides them. If scripting is
       off or blocked this line never runs and every panel stays visible. */
    document.documentElement.classList.add('js-reveals');
  </script>
</head>
<body data-page="{{ page.fileSlug or 'home' }}">
<canvas id="starfield" aria-hidden="true"></canvas>
<div class="veil" aria-hidden="true"></div>
{% include "partials/geo.njk" %}

<a class="skip" href="#main">Skip to the work</a>

{% include "partials/header.njk" %}

<main id="main">
  {{ content | safe }}
</main>

{% include "partials/footer.njk" %}

<div class="scroll-rail" id="scroll-rail" aria-hidden="true" hidden>
  <button class="scroll-arrow scroll-arrow--up" type="button" id="scroll-top"
          title="Back to the top" aria-label="Scroll to the top of the page"
          aria-hidden="true" tabindex="-1" disabled>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 19V5M5 12l7-7 7 7"/>
    </svg>
  </button>
  <button class="scroll-arrow scroll-arrow--down" type="button" id="scroll-bottom"
          title="Down to the foot of the page" aria-label="Scroll to the bottom of the page"
          aria-hidden="true" tabindex="-1" disabled>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 5v14M5 12l7 7 7-7"/>
    </svg>
  </button>
</div>
{% include "partials/cookies.njk" %}

<script src="/assets/js/site.js?v={{ build.id }}" defer></script>
<script src="/assets/js/admin-edit.js?v={{ build.id }}" defer></script>
</body>
</html>

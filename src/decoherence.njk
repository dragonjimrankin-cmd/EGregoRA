        <rect x="40" y="80" width="580" height="58" rx="6" fill="rgba(215,176,90,.04)" stroke="#7fae7a" stroke-opacity=".5"/>
        <text x="64" y="106" font-family="Georgia,serif" font-size="13.5" fill="#7fae7a">conserved, and scrambled beyond recall</text>
        <text x="64" y="124" font-family="Georgia,serif" font-size="11" fill="#9f947a">what unitarity guarantees on its own</text>
        <text x="590" y="118" text-anchor="middle" font-family="Georgia,serif" font-size="22" fill="#7fae7a">&#10003;</text>
        <rect x="40" y="158" width="580" height="58" rx="6" fill="rgba(215,176,90,.04)" stroke="#d7b05a" stroke-opacity=".5"/>
        <text x="64" y="184" font-family="Georgia,serif" font-size="13.5" fill="#d7b05a">conserved, and gathered up again</text>
        <text x="64" y="202" font-family="Georgia,serif" font-size="11" fill="#9f947a">what the traditions describe</text>
        <text x="590" y="196" text-anchor="middle" font-family="Georgia,serif" font-size="22" fill="#d7b05a">?</text>
        <rect x="40" y="236" width="580" height="58" rx="6" fill="rgba(215,176,90,.04)" stroke="#c98b6a" stroke-opacity=".5"/>
        <text x="64" y="262" font-family="Georgia,serif" font-size="13.5" fill="#c98b6a">simply destroyed</text>
        <text x="64" y="280" font-family="Georgia,serif" font-size="11" fill="#9f947a">the one case no known physics allows</text>
        <text x="590" y="274" text-anchor="middle" font-family="Georgia,serif" font-size="22" fill="#c98b6a">&#10007;</text>
        <text x="330" y="318" text-anchor="middle" font-family="Georgia,serif" font-size="11" fill="#cbbb93">the middle row is not ruled out. it is also not evidenced. that is the whole honest position.</text>
      </svg>

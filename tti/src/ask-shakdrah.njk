          <input id="md-texfile" type="file" accept="image/*" class="sound-file">
          <button class="tool" type="button" id="md-duplicate">Duplicate</button>
          <button class="tool" type="button" id="md-delete">Delete</button>
          <button class="tool" type="button" id="md-all">Select all</button>
          <button class="tool" type="button" id="md-lasso" aria-pressed="false">Lasso several</button>
          <button class="tool" type="button" id="md-stitch">Stitch together</button>

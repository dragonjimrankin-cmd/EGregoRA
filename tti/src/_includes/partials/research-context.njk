{% set researchPage = site.researchByUrl[page.url] %}
{% if researchPage %}
<section class="project-context wrap" aria-label="Research document context">
  <div class="project-context-line">
    <div class="project-record">
      <span class="project-record-code">{{ researchPage.code }}</span>
      <span class="project-record-kind">{{ researchPage.kind }}</span>
      <span class="project-record-status">{{ researchPage.status }}</span>
    </div>
  </div>

  <div class="project-context-nav">
    {% if researchPage.previous %}
    <a class="project-context-step project-context-step--previous" href="{{ researchPage.previous.url }}">
      <span>Previous</span>
      <strong>{{ researchPage.previous.code }} · {{ researchPage.previous.label }}</strong>
    </a>
    {% else %}
    <span class="project-context-step is-empty" aria-hidden="true"></span>
    {% endif %}

    <p class="project-context-position">
      <span>Part {{ researchPage.part }} · {{ researchPage.partTitle }}</span>
      <strong>Document {{ researchPage.index }} of {{ researchPage.total }}</strong>
    </p>

    {% if researchPage.next %}
    <a class="project-context-step project-context-step--next" href="{{ researchPage.next.url }}">
      <span>Next</span>
      <strong>{{ researchPage.next.code }} · {{ researchPage.next.label }}</strong>
    </a>
    {% else %}
    <span class="project-context-step is-empty" aria-hidden="true"></span>
    {% endif %}
  </div>
</section>
{% endif %}

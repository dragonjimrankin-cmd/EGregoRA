<header class="site-head" id="top" data-site-header>
  <div class="head-accent"></div>
  <div class="brand-row wrap wide">
    <a class="brand" href="/" aria-label="{{ site.name }} — home">
      <svg class="brand-sigil" viewBox="0 0 64 64" role="img" aria-hidden="true">
        <defs>
          <linearGradient id="sigil-gradient" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="currentColor"/>
            <stop offset="1" stop-color="var(--verdant)"/>
          </linearGradient>
        </defs>
        <path d="M12 35c7-18 18-24 32-18 10 5 10 18 2 24-8 6-20 1-18-8 2-8 14-10 23-4" fill="none" stroke="url(#sigil-gradient)" stroke-width="2"/>
        <path d="M10 35c7 18 19 23 34 16" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="3 3" opacity=".7"/>
        <circle cx="10" cy="35" r="2.5" fill="currentColor"/>
        <circle cx="52" cy="29" r="2.5" fill="var(--verdant)"/>
      </svg>
      <span class="brand-text">
        <span class="brand-name">The Two Infinities: Eternal Integration of the Self</span>
        <span class="brand-tag">A speculative cosmology by Jim Rankin, UK, 2026</span>
      </span>
    </a>
    <a class="brand-edition" href="/archive/" aria-label="Open {{ site.revision }} research record">
      <span>Research edition</span><strong>{{ site.revision }}</strong>
    </a>
    <a class="head-join" href="/join/" id="head-join">
      <span class="head-join-mark" aria-hidden="true">&#9737;</span>
      <span class="head-join-text">Sign in <span class="head-join-or">/ Join</span></span>
    </a>
    <button class="nav-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="primary-nav">
      <span class="nav-toggle-icon" aria-hidden="true"><b></b><b></b><b></b></span><em>Contents</em>
    </button>
  </div>

  <nav id="primary-nav" class="site-nav" aria-label="Primary navigation">
    <div class="site-nav-shell">
      <div class="focus-nav" aria-label="Fundamental conjectures and integrated research Parts I to III">
        {% for focus in site.focusAreas %}
          <details class="nav-cluster focus-cluster focus-cluster--{{ focus.key }}">
            <summary class="focus-nav-link focus-nav-link--{{ focus.key }}" data-focus-route="{{ focus.url }}">
              <span class="focus-nav-num">{{ focus.numeral }}</span>
              <span class="focus-nav-copy"><small>{{ focus.eyebrow }}</small><strong>{{ focus.label }}</strong></span>
              <span class="nav-chevron" aria-hidden="true"></span>
            </summary>
            <div class="nav-panel focus-panel">
              <div class="nav-panel-head focus-panel-head">
                <p class="nav-panel-kicker">Research programme under {{ focus.label }}</p>
                <h2>Part {{ focus.part }} · {{ focus.partTitle }}</h2>
                <p>{{ focus.partNote }}</p>
              </div>
              <ul>
                {% for item in focus.documents %}
                  <li>
                    <a data-research-document data-focus-document href="{{ item.url }}" title="{{ item.note }}"{% if page.url == item.url %} aria-current="page"{% endif %}>
                      <i aria-hidden="true">{% glyph item.glyph %}</i>
                      <span class="nav-link-copy">
                        <small class="focus-doc-code">{{ item.code }} · {{ item.kind }}</small>
                        <strong>{{ item.label }}</strong>
                        <small>{{ item.note }}</small>
                      </span>
                      <span class="nav-link-arrow" aria-hidden="true">→</span>
                    </a>
                  </li>
                {% endfor %}
              </ul>
            </div>
          </details>
        {% endfor %}
      </div>

      <div class="nav-actions nav-actions--focus">
        <details class="nav-cluster nav-archive">
          <summary aria-label="Open supporting Parts IV to VI and the complete six-Part research archive">
            <i aria-hidden="true">{% glyph "ledger" %}</i>
            <span class="nav-archive-copy"><small>Parts IV–VI</small><strong>Supporting Research</strong></span>
            <span class="nav-chevron" aria-hidden="true"></span>
          </summary>
          <div class="nav-panel archive-panel">
            <div class="archive-panel-head">
              <div>
                <p class="nav-panel-kicker">Tests, resources and mathematical audit</p>
                <p>Parts I–III now sit beneath the three conjectures; Parts IV–VI support, test and document them.</p>
              </div>
              <a class="archive-index-link" href="/archive/"{% if page.url == '/archive/' %} aria-current="page"{% endif %}>
                Open complete Research Archive <span aria-hidden="true">→</span>
              </a>
            </div>
            <div class="archive-part-grid">
              {% for group in site.supportingNavGroups %}
                <section class="archive-part" aria-labelledby="archive-part-{{ group.part }}">
                  <div class="archive-part-head">
                    <span>Part {{ group.part }}</span>
                    <h2 id="archive-part-{{ group.part }}">{{ group.label }}</h2>
                  </div>
                  <ul>
                    {% for item in group.items %}
                      <li>
                        <a data-research-document data-archive-document href="{{ item.url }}" title="{{ item.note }}"{% if page.url == item.url %} aria-current="page"{% endif %}>
                          <i aria-hidden="true">{% glyph item.glyph %}</i>
                          <span class="nav-link-copy">
                            <small class="archive-doc-code">{{ item.code }}</small>
                            <strong>{{ item.label }}</strong>
                            <small>{{ item.note }}</small>
                          </span>
                          <span class="nav-link-arrow" aria-hidden="true">→</span>
                        </a>
                      </li>
                    {% endfor %}
                  </ul>
                </section>
              {% endfor %}
            </div>
          </div>
        </details>
        <a class="nav-action nav-action--compact" href="/plates/">
          <i aria-hidden="true">{% glyph "eye" %}</i><span>Plates</span>
        </a>
        <a class="nav-action nav-action--primary nav-action--compact" href="/ask-shakdrah/">
          <i aria-hidden="true">{% glyph "dragon" %}</i><span>Ask ShakDrah</span>
        </a>
      </div>
    </div>
  </nav>
</header>

<header class="site-head site-head--reference" id="top" data-site-header>
  <div class="rule rule--top head-accent" aria-hidden="true"></div>
  <div class="brand-row wrap wide">
    <a class="brand" href="/" aria-label="{{ site.name }} — home">
      <span class="brand-sigil" aria-hidden="true">{% glyph "torus" %}</span>
      <span class="brand-text">
        <span class="brand-line" aria-hidden="true">
          <span class="brand-name">The Two Infinities</span>
          <span class="brand-order">
            <span class="brand-rule"></span>
            <span class="brand-order-text">A Geometry <em>of</em> Existence &middot; {{ site.revision }}</span>
            <span class="brand-rule"></span>
          </span>
          <span class="brand-essence">Eternal Integration of the Self</span>
        </span>
        <span class="brand-tag">A speculative cosmology by Jim Rankin, UK, 2026</span>
        <span class="sr-only">The Two Infinities: Eternal Integration of the Self</span>
      </span>
    </a>
    <a class="head-join" href="/join/" id="head-join">
      <span class="head-join-mark" aria-hidden="true">&#9737;</span>
      <span class="head-join-text">Sign in <span class="head-join-or">/ Join</span></span>
    </a>
    <button class="nav-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="primary-nav">
      <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span><em>Menu</em>
    </button>
  </div>

  <nav id="primary-nav" class="site-nav reference-nav" aria-label="Complete six-Part research index">
    <ul class="reference-nav-list">
      <li class="reference-nav-overview-row">
        <ul aria-label="Project overview">
          <li class="reference-nav-overview">
            <a href="/"{% if page.url == '/' %} aria-current="page"{% endif %}>
              <i aria-hidden="true">{% glyph "eye" %}</i><span>Summary</span>
            </a>
          </li>
          <li class="reference-nav-overview">
            <a href="/archive/#project-contents"{% if page.url == '/archive/' %} aria-current="page"{% endif %} aria-label="Full table of contents: all six Parts and 35 project documents">
              <i aria-hidden="true">{% glyph "metatron" %}</i><span>Table of Contents</span>
            </a>
          </li>
        </ul>
      </li>
      {% for group in site.navGroups %}
        <li class="reference-part-row reference-part-row--{{ group.part | lower }}">
          <div class="reference-part-label reference-part-{{ group.part | lower }}">
            <a href="{{ group.items[0].url }}" aria-label="Part {{ group.part }} — {{ group.shortLabel }}">
              <span class="reference-part-num">{{ group.part }}</span>
              <span>Part {{ group.part }}<small>{{ group.shortLabel }}</small></span>
            </a>
          </div>
          <ul class="reference-part-documents" aria-label="Part {{ group.part }} — {{ group.shortLabel }} papers">
            {% for item in group.items %}
              <li class="reference-nav-item reference-nav-item--part-{{ group.part | lower }}">
                <a data-research-document {% if group.part == 'I' or group.part == 'II' or group.part == 'III' %}data-focus-document{% else %}data-archive-document{% endif %}
                  href="{{ item.url }}" title="Part {{ group.part }} — {{ group.shortLabel }} · {{ item.label }} · {{ item.note }}"{% if page.url == item.url %} aria-current="page"{% endif %}>
                  <i aria-hidden="true">{% glyph item.glyph %}</i>
                  <span>{{ item.mastheadLabel }}</span>
                  <span class="sr-only"> — Part {{ group.part }}, {{ group.shortLabel }}; {{ item.code }}</span>
                </a>
              </li>
            {% endfor %}
          </ul>
        </li>
      {% endfor %}
    </ul>
  </nav>
  <div class="rule rule--bottom" aria-hidden="true"></div>
</header>

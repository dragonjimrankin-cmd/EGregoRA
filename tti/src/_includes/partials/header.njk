<header class="site-head" id="top" data-site-header>
  <div class="head-accent" aria-hidden="true"></div>
  <div class="brand-row wrap wide">
    <a class="brand" href="/" aria-label="{{ site.name }} — home">
      <span class="brand-sigil" aria-hidden="true">{% glyph "torus" %}</span>
      <span class="brand-text">
        <span class="brand-line">
          <span class="brand-name">The Two Infinities: Eternal Integration of the Self</span>
          <span class="brand-order" aria-hidden="true">
            <span class="brand-rule"></span>
            <span class="brand-order-text">Research edition &middot; {{ site.revision }}</span>
            <span class="brand-rule"></span>
          </span>
        </span>
        <span class="brand-tag">A speculative cosmology by Jim Rankin, UK, 2026</span>
      </span>
    </a>
    <a class="head-join" href="/join/" id="head-join">
      <span class="head-join-mark" aria-hidden="true">&#9737;</span>
      <span class="head-join-text">Sign in <span class="head-join-or">/ Join</span></span>
    </a>
    <button class="nav-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="primary-nav">
      <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span><em>Menu</em>
    </button>
  </div>

  <nav id="primary-nav" class="site-nav" aria-label="Primary navigation">
    <div class="site-nav-shell">
      <div class="focus-nav" aria-label="Fundamental conjectures">
        {% for focus in site.focusAreas %}
          <a class="focus-nav-link focus-nav-link--{{ focus.key }}{% if page.url == focus.url %} is-current{% endif %}" href="{{ focus.url }}">
            <span class="focus-nav-num">{{ focus.numeral }}</span>
            <span class="focus-nav-copy"><small>{{ focus.eyebrow }}</small><strong>{{ focus.label }}</strong></span>
          </a>
        {% endfor %}
      </div>

      <div class="nav-actions nav-actions--focus">
        <details class="nav-cluster nav-archive">
          <summary aria-label="Open the complete six-Part research archive">
            <i aria-hidden="true">{% glyph "ledger" %}</i>
            <span class="nav-archive-copy"><small>All six Parts</small><strong>Research Archive</strong></span>
            <span class="nav-chevron" aria-hidden="true"></span>
          </summary>
          <div class="nav-panel archive-panel">
            <div class="archive-panel-head">
              <div>
                <p class="nav-panel-kicker">Complete research record</p>
                <p>Six Parts · {{ site.research.documentCount }} studies · {{ site.research.resourceCount }} project resources</p>
              </div>
              <a class="archive-index-link" href="/archive/"{% if page.url == '/archive/' %} aria-current="page"{% endif %}>
                Open archive overview <span aria-hidden="true">→</span>
              </a>
            </div>
            <div class="archive-part-grid">
              {% for group in site.navGroups %}
                <section class="archive-part" aria-labelledby="archive-part-{{ group.part }}">
                  <div class="archive-part-head">
                    <span>Part {{ group.part }}</span>
                    <h2 id="archive-part-{{ group.part }}">{{ group.label }}</h2>
                  </div>
                  <ul>
                    {% for item in group.items %}
                      <li>
                        <a data-archive-document href="{{ item.url }}" title="{{ item.note }}"{% if page.url == item.url %} aria-current="page"{% endif %}>
                          <i aria-hidden="true">{% glyph item.glyph %}</i>
                          <span class="nav-link-copy">
                            <small class="archive-doc-code">{{ item.code }}</small>
                            <strong>{{ item.label }}</strong>
                            <small>{{ item.note }}</small>
                          </span>
                          <span class="nav-link-arrow" aria-hidden="true">→</span>
                        </a>
                      </li>
                    {% endfor %}
                  </ul>
                </section>
              {% endfor %}
            </div>
          </div>
        </details>
        <a class="nav-action nav-action--compact" href="/plates/">
          <i aria-hidden="true">{% glyph "eye" %}</i><span>Plates</span>
        </a>
        <a class="nav-action nav-action--primary nav-action--compact" href="/ask-shakdrah/">
          <i aria-hidden="true">{% glyph "dragon" %}</i><span>Ask ShakDrah</span>
        </a>
      </div>
    </div>
  </nav>
</header>

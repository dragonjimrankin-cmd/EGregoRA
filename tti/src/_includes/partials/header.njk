<header class="site-head" data-site-header>
  <div class="head-accent" aria-hidden="true"></div>

  <div class="brand-row">
    <a class="brand" href="/" aria-label="{{ site.name }} — home">
      <span class="brand-sigil" aria-hidden="true">{% glyph "torus" %}</span>
      <span class="brand-text">
        <span class="brand-name">{{ site.name }}</span>
        <span class="brand-tag">{{ site.tagline }}</span>
      </span>
    </a>

    <a class="brand-edition" href="/#project-contents"
       aria-label="Open the project table of contents, working edition {{ site.revision }}">
      <span>Project contents</span>
      <strong>{{ site.revision }}</strong>
    </a>

    <a class="head-join" href="/join/" id="head-join">
      <span class="head-join-mark" aria-hidden="true">&#9737;</span>
      <span class="head-join-text">Sign in <span class="head-join-or">/ Join</span></span>
    </a>

    <button class="nav-toggle" type="button" aria-label="Open navigation" aria-expanded="false"
            aria-controls="primary-nav">
      <span class="nav-toggle-icon" aria-hidden="true"><b></b><b></b><b></b></span>
      <em>Contents</em>
    </button>
  </div>

  <nav id="primary-nav" class="site-nav" aria-label="Project table of contents">
    <div class="site-nav-shell">
      <div class="nav-clusters">
        {% for group in site.navGroups %}
        <details class="nav-cluster">
          <summary>
            <span class="nav-cluster-index">Part {{ group.part }}</span>
            <span class="nav-cluster-title">{{ group.shortLabel }}</span>
            <span class="nav-chevron" aria-hidden="true"></span>
          </summary>
          <div class="nav-panel">
            <div class="nav-panel-head">
              <p class="nav-panel-kicker">{{ group.label }}</p>
              <p>{{ group.note }}</p>
            </div>
            <ul>
              {% for item in group.items %}
              <li>
                <a href="{{ item.url }}" {% if page.url == item.url %}aria-current="page"{% endif %}>
                  <i aria-hidden="true">{% glyph item.glyph %}</i>
                  <span class="nav-link-copy">
                    <span class="nav-link-meta">{{ item.code }} · {{ item.kind }}</span>
                    <strong>{{ item.label }}</strong>
                    <small>{{ item.note }}</small>
                  </span>
                  <span class="nav-link-arrow" aria-hidden="true">&rarr;</span>
                </a>
              </li>
              {% endfor %}
            </ul>
          </div>
        </details>
        {% endfor %}
      </div>

      {% if site.navActions.length %}
      <div class="nav-actions">
        {% for item in site.navActions %}
        <a class="nav-action nav-action--{{ item.kind }}" href="{{ item.url }}"
           {% if page.url == item.url %}aria-current="page"{% endif %}>
          <i aria-hidden="true">{% glyph item.glyph %}</i>
          <span>{{ item.label }}</span>
        </a>
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </nav>
</header>

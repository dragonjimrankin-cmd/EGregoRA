        <g stroke="#45d6b4" stroke-width="1.4" fill="none">
          <circle cx="570" cy="170" r="82"/>
        </g>
        <g fill="#cdefff" font-family="EB Garamond, serif" font-size="13" text-anchor="middle">
          <circle cx="570" cy="88" r="5" fill="#76cfee"/><text x="570" y="78">1</text>

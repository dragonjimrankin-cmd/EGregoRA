          <path d="M70 180 H330"/>
        </g>
        <g fill="#cdefff" font-family="EB Garamond, serif" font-size="13" text-anchor="middle">
          <circle cx="70" cy="180" r="5" fill="#76cfee"/><text x="70" y="206">1</text>
          <text x="340" y="184" text-anchor="start" fill="#a9b6d8">&#8594; 0, forever</text>

<section id="project-contents" class="research-toc wrap wide reveal" aria-labelledby="research-toc-title">
  <div class="section-head">
    <div>
      <p class="kicker">Canonical sequence</p>
      <h2 id="research-toc-title">Complete Six-Part Table of Contents</h2>
    </div>
    <p class="lede muted">Stable project codes preserve the scope and ordering of the full programme.</p>
  </div>

  <div class="research-toc-grid">
    {% for group in site.navGroups %}
      <section class="research-toc-part frame" aria-labelledby="toc-part-{{ group.part }}">
        <div class="research-toc-part-head">
          <p>Part {{ group.part }}</p>
          <h3 id="toc-part-{{ group.part }}">{{ group.label }}</h3>
          <span>{{ group.items.length }} {% if group.items.length == 1 %}document{% else %}documents{% endif %}</span>
        </div>
        <ol>
          {% for item in group.items %}
            <li>
              <a href="{{ item.url }}">
                <span class="research-toc-code">{{ item.code }}</span>
                <span class="research-toc-copy">
                  <strong>{{ item.label }}</strong>
                  <small>{{ item.kind }} · {{ item.status }}</small>
                  <span>{{ item.aim }}</span>
                </span>
              </a>
            </li>
          {% endfor %}
        </ol>
      </section>
    {% endfor %}
  </div>
</section>

<section id="atlas-box" class="atlas-box wrap wide reveal" aria-labelledby="atlas-heading">
  <div class="page-head">
    <p class="kicker">Interactive dependency map</p>
    <h2 id="atlas-heading">The Atlas of Becoming</h2>
    <p class="lede">The table of contents fixes the archive&rsquo;s reading order; this Atlas shows the same six research divisions as a navigable model. Open one division at a time, or search directly by document.</p>
  </div>

  <div class="frame">
    <div class="atlas-grid">
      <div class="atlas-stage-wrap">
        <div class="atlas-stage" id="atlas-stage" role="region" aria-label="Interactive three-dimensional map of the TTI reading paths">
          <div class="atlas-labels" id="atlas-labels"></div>
        </div>
      </div>

      <aside class="atlas-side" aria-label="Atlas controls and selected destination">
        <p class="kicker">View the project as</p>
        <div class="atlas-tools" aria-label="Choose the visual form">
          <button class="btn" type="button" data-skin="figure" aria-pressed="true">The Figure</button>
          <button class="btn" type="button" data-skin="cosmos" aria-pressed="false">The Cosmos</button>
          <button class="btn" type="button" data-skin="tree" aria-pressed="false">The Tree</button>
          <button class="btn" type="button" data-skin="galaxy" aria-pressed="false">The Galaxy</button>
        </div>
        <p class="muted small" id="atlas-skin-note">The plain branching body. The clearest of the four to read.</p>

        <div class="atlas-tools" aria-label="Move and fold the map">
          <button class="btn" type="button" id="at-focus" aria-pressed="false">Fill the screen</button>
          <button class="btn" type="button" id="at-spin" aria-pressed="true">Hold Still</button>
          <button class="btn" type="button" id="at-fold">Fold Away</button>
          <button class="btn" type="button" id="at-home">Whole Map</button>
        </div>

        <label class="atlas-find" for="at-find">Find a research document or resource</label>
        <input id="at-find" type="search" autocomplete="off" placeholder="Try gravity, Möbius, Plates…">
        <p class="atlas-status muted small" id="atlas-status" aria-live="polite"></p>
        <div class="atlas-read" id="atlas-read">
          <p class="muted small">Turn it with a drag, come closer with the wheel. Click a reading path to open it — only one stem stands open at a time, so the rest fold away.</p>
        </div>
      </aside>
    </div>

    <details class="scroll">
      <summary>The same map, written out</summary>
      <nav class="atlas-list" aria-label="Written TTI navigation map">
        <p><a href="/"><strong>The Two Infinities: Eternal Integration of the Self</strong></a></p>
        <ol type="I">
          {% for path in ttiAtlas.limbs %}
          <li>
            <a href="{{ path.href }}"><strong>{{ path.title }}</strong></a>
            <span class="muted"> — {{ path.note }}</span>
            <ul>
              {% for destination in path.subs %}
              <li><a href="{{ destination.href }}"><span class="toc-code">{{ destination.code }}</span> {{ destination.title }}</a>
                <span class="muted"> — {{ destination.kind }} · {{ destination.status }}. {{ destination.note }}</span></li>
              {% endfor %}
            </ul>
          </li>
          {% endfor %}
        </ol>
      </nav>
    </details>
  </div>

  <script type="application/json" id="atlas-data">{{ ttiAtlas | dump | safe }}</script>
  <script type="module" src="/assets/js/atlas.js"></script>
</section>

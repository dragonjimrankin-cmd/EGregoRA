          <circle cx="300" cy="206" r="5" fill="#76cfee"/><text x="300" y="232">z = 0</text>
          <circle cx="380" cy="206" r="5" fill="#45d6b4"/><text x="380" y="232">z = ½</text>
          <circle cx="470" cy="206" r="5" fill="#a07cf0"/><text x="470" y="232">z = 1</text>

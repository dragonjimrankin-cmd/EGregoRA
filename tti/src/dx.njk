        <text x="656" y="82" fill="#ffd979" font-size="13">A + M/&eta;</text>

        <polyline fill="none" stroke="#a07cf0" stroke-width="2.6"
                  points="70,98 232,98 232,140 394,140 394,186 556,186 556,228 648,228"/>
        <text x="656" y="232" fill="#a07cf0" font-size="13">M</text>
